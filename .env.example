# Never commit real credentials. Set these values in Vercel Project Settings
# and in .env.local for `vercel dev`.
SCHEDULE_ADMIN_USERNAME=replace-with-sashas-login
SCHEDULE_ADMIN_PASSWORD_HASH='scrypt$65536$8$1$replace-with-generated-salt$replace-with-generated-hash'
SCHEDULE_SESSION_SECRET=replace-with-at-least-32-random-characters

# Shared schedule storage. Keep the secret key server-side only; never expose it
# through HTML, client-side JavaScript, or a public-prefixed environment value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-secret

# Generate SCHEDULE_ADMIN_PASSWORD_HASH interactively:
# npm run auth:hash
